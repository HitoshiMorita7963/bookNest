// BookNest データベーススキーマ
// SQLite では enum の代わりに String を使い、値の検証は Zod (src/lib/validators.ts) で行う。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 個人用アプリのため単一ユーザー。プロフィールと設定を保持する。
model User {
  id        String   @id @default("me")
  name      String   @default("")
  bio       String?
  settings  String   @default("{}") // JSON 文字列 (テーマ・OCR・AI 設定など)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id           String    @id @default(cuid())
  title        String
  titleKana    String?
  subtitle     String?
  description  String?
  isbn10       String?
  isbn13       String?   @unique
  publisher    String?
  publishedAt  String? // "2024", "2024-05", "2024-05-10" など部分日付を許容
  publishedYear Int?
  pageCount    Int?
  coverImage   String?
  language     String?   @default("ja")
  genre        String? // 主ジャンル（統計用）
  // WANT_TO_READ | OWNED | READING | COMPLETED | PAUSED | DROPPED
  status       String    @default("WANT_TO_READ")
  currentPage  Int       @default(0)
  rating       Int? // 最新の読書記録の評価（並び替え用の非正規化）
  acquiredAt   DateTime? // 購入・入手日（積読期間の計算に使用）
  startedAt    DateTime? // 最新の読書開始日（非正規化）
  finishedAt   DateTime? // 最新の読了日（非正規化）
  seriesId     String?
  seriesNumber Float?
  isSample     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  series     Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  authors    BookAuthor[]
  tags       BookTag[]
  records    ReadingRecord[]
  sessions   ReadingSession[]
  shelves    ShelfBook[]
  quotes     Quote[]
  knowledge  BookKnowledge[]
  paths      ReadingPathBook[]
  relatedTo  BookRelation[]    @relation("fromBook")
  relatedBy  BookRelation[]    @relation("toBook")

  @@index([status])
  @@index([title])
  @@index([createdAt])
  @@index([finishedAt])
  @@index([genre])
  @@index([seriesId])
  @@index([isbn10])
}

model Author {
  id        String       @id @default(cuid())
  name      String       @unique
  nameKana  String?
  profile   String?
  isSample  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  books     BookAuthor[]
}

model BookAuthor {
  bookId   String
  authorId String
  role     String @default("著")
  position Int    @default(0)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
}

model Series {
  id           String   @id @default(cuid())
  title        String   @unique
  description  String?
  totalVolumes Int?
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  books        Book[]
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  books     BookTag[]
  quotes    QuoteTag[]
  knowledge KnowledgeTag[]
}

model BookTag {
  bookId String
  tagId  String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
  @@index([tagId])
}

// 本ごとの読書記録（再読に対応するため Book とは別）
model ReadingRecord {
  id         String    @id @default(cuid())
  bookId     String
  // READING | COMPLETED | PAUSED | DROPPED
  status     String    @default("READING")
  startedAt  DateTime?
  finishedAt DateTime?
  rating     Int?
  review     String?
  summary    String?
  learned    String?
  memorable  String?
  questions  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions   ReadingSession[]

  @@index([bookId])
  @@index([finishedAt])
  @@index([status])
}

// 日々の読書活動（進捗更新・メモ）。読書カレンダーの元データ。
model ReadingSession {
  id        String         @id @default(cuid())
  bookId    String
  recordId  String?
  date      DateTime       @default(now())
  startPage Int?
  endPage   Int?
  pagesRead Int            @default(0)
  minutes   Int?
  note      String?
  createdAt DateTime       @default(now())
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  record    ReadingRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([bookId])
}

model CustomShelf {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  position    Int         @default(0)
  isSample    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  books       ShelfBook[]
}

model ShelfBook {
  shelfId  String
  bookId   String
  position Int         @default(0)
  addedAt  DateTime    @default(now())
  shelf    CustomShelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book     Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([shelfId, bookId])
  @@index([bookId])
}

model ReadingGoal {
  id        String   @id @default(cuid())
  // YEARLY_BOOKS | YEARLY_PAGES | MONTHLY_BOOKS | GENRE_BOOKS
  type      String
  year      Int
  month     Int?
  genre     String?
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}

// 本から保存した文章
model Quote {
  id            String           @id @default(cuid())
  text          String
  originalImage String?
  bookId        String?
  pageNumber    String? // "142" / "142-143" / "序章" / "位置No.1234"
  note          String? // なぜ残したのか（自分のメモ）
  isFavorite    Boolean          @default(false)
  isSample      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  book          Book?            @relation(fields: [bookId], references: [id], onDelete: SetNull)
  tags          QuoteTag[]
  knowledge     QuoteKnowledge[]

  @@index([bookId])
  @@index([createdAt])
}

model QuoteTag {
  quoteId String
  tagId   String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([quoteId, tagId])
  @@index([tagId])
}

// 読書から得た知識・理解
model KnowledgeNote {
  id        String           @id @default(cuid())
  title     String
  content   String           @default("")
  category  String?
  isSample  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tags      KnowledgeTag[]
  books     BookKnowledge[]
  quotes    QuoteKnowledge[]
  linksFrom KnowledgeLink[]  @relation("linkFrom")
  linksTo   KnowledgeLink[]  @relation("linkTo")

  @@index([title])
  @@index([category])
}

model KnowledgeTag {
  knowledgeId String
  tagId       String
  knowledge   KnowledgeNote @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  tag         Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([knowledgeId, tagId])
  @@index([tagId])
}

model BookKnowledge {
  bookId      String
  knowledgeId String
  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  knowledge   KnowledgeNote @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@id([bookId, knowledgeId])
  @@index([knowledgeId])
}

model QuoteKnowledge {
  quoteId     String
  knowledgeId String
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  knowledge   KnowledgeNote @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@id([quoteId, knowledgeId])
  @@index([knowledgeId])
}

// 知識マップ用の知識同士のつながり（有向）
model KnowledgeLink {
  fromId    String
  toId      String
  label     String?
  createdAt DateTime      @default(now())
  from      KnowledgeNote @relation("linkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        KnowledgeNote @relation("linkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
}

// 本と本の関連（ユーザーが手動で関連付け）
model BookRelation {
  fromId    String
  toId      String
  note      String?
  createdAt DateTime @default(now())
  from      Book     @relation("fromBook", fields: [fromId], references: [id], onDelete: Cascade)
  to        Book     @relation("toBook", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId])
}

model ReadingPath {
  id          String            @id @default(cuid())
  title       String
  description String?
  isSample    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  books       ReadingPathBook[]
}

model ReadingPathBook {
  pathId   String
  bookId   String
  position Int         @default(0)
  note     String?
  path     ReadingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  book     Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([pathId, bookId])
  @@index([bookId])
}

model AIConversation {
  id        String      @id @default(cuid())
  title     String      @default("新しい会話")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  sources        String? // 参照した本・フレーズ・知識 (JSON)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
