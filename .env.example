# ===== BookNest 環境変数 =====
# 実際の値は .env に記載してください（.env は Git 管理対象外）

# SQLite データベース（prisma/schema.prisma からの相対パス）
DATABASE_URL="file:../data/booknest.db"

# --- ISBN 検索 ---
# openBD（キー不要）→ Google Books の順に検索します。
# Google Books API キーは任意（未設定でも動作しますが回数制限が厳しくなります）
GOOGLE_BOOKS_API_KEY=

# --- AI 司書 ---
# AI_PROVIDER: "anthropic" または "none"（未設定時はキーがあれば anthropic）
AI_PROVIDER=
AI_API_KEY=
# 使用モデル（任意）
AI_MODEL=claude-opus-5

# --- OCR ---
# OCR_PROVIDER: "tesseract"（端末内処理・既定）または "google-vision"（サーバー経由）
OCR_PROVIDER=tesseract
# google-vision を使う場合のみ
OCR_API_KEY=

# アップロード画像の最大サイズ（MB）
MAX_UPLOAD_MB=10

# ===== クラウド（Vercel）で公開する場合 =====
# 詳しい手順は docs/cloud-setup.md を参照
# ログイン用パスワード（設定するとログインが必要になる。クラウドでは必須）
APP_PASSWORD=
# セッション署名用のランダムな文字列（任意。未設定なら APP_PASSWORD を使用）
AUTH_SECRET=
# Turso（クラウドの DB）。設定すると DATABASE_URL の代わりにこちらを使う
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob（画像の保存先）。Vercel で Blob ストアを接続すると自動で設定される
BLOB_READ_WRITE_TOKEN=
