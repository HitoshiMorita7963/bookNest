# ===== BookNest 環境変数 =====
# 実際の値は .env に記載してください（.env は Git 管理対象外）

# SQLite データベース（prisma/schema.prisma からの相対パス）
DATABASE_URL="file:../data/booknest.db"

# --- ISBN 検索・表紙画像 ---
# 楽天ブックス → openBD → 国立国会図書館 → Google Books の順に検索します。
# 楽天ブックスAPI（任意・表紙画像が最も充実）。https://webservice.rakuten.co.jp/ でアプリを登録して取得
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天は、アプリ登録時の「許可されたWebサイト」と同じURLを送る必要があります（未設定なら APP_URL を使用）
RAKUTEN_ALLOWED_URL=
# Google Books API キーは任意（未設定でも動作しますが回数制限が厳しくなります）
GOOGLE_BOOKS_API_KEY=

# --- AI 司書・AI 編集者 ---
# AI_PROVIDER: "openai"（ChatGPT）/ "anthropic"（Claude）/ "none"（未設定時はキーがあれば anthropic）
AI_PROVIDER=
# 選んだプロバイダの API キー（OpenAI なら sk-… / Anthropic なら sk-ant-…）
AI_API_KEY=
# 使用モデルのID（任意）。openai の既定は gpt-6-luna、anthropic の既定は claude-opus-5
AI_MODEL=

# --- OCR ---
# OCR_PROVIDER: "tesseract"（端末内処理・既定）または "google-vision"（サーバー経由）
OCR_PROVIDER=tesseract
# google-vision を使う場合のみ
OCR_API_KEY=

# アップロード画像の最大サイズ（MB）
MAX_UPLOAD_MB=10

# ===== クラウド（Vercel）で公開する場合 =====
# 詳しい手順は docs/cloud-setup.md を参照
# ログイン用パスワード（設定するとログインが必要になる。クラウドでは必須）
APP_PASSWORD=
# セッション署名用のランダムな文字列（任意。未設定なら APP_PASSWORD を使用）
AUTH_SECRET=
# Turso（クラウドの DB）。設定すると DATABASE_URL の代わりにこちらを使う
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob（画像の保存先）。Vercel で Blob ストアを接続すると自動で設定される
BLOB_READ_WRITE_TOKEN=

# ===== Google スプレッドシートへの自動反映（任意） =====
# 手順は docs/sheets-sync.md を参照
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
# BookNest の公開URL（任意。シートのリンク列を完全なURLにする）
APP_URL=
